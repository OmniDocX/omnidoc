# UniPPT built-in U AI provider (OpenAI-compatible)
# Copy to .env.local for local development. Never commit the real key.
# MCP clients choose their own model; these settings only configure the
# optional built-in U AI / OCR routes served by UniPPT.
UNIPPT_AI_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
UNIPPT_AI_MODEL=qwen3.7-flash
# Dedicated coordinate OCR uses DashScope's native API, not chat completions.
UNIPPT_OCR_MODEL=qwen3.5-ocr
UNIPPT_AI_KEY=

# Server port is read from the process environment, not this AI settings file:
# PowerShell: $env:UNIPPT_PORT = "8141"
# POSIX: export UNIPPT_PORT=8141
